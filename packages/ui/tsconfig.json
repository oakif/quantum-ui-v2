{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../apps/v4/*"],
      "~ui/*": ["../../apps/v4/registry/coss-ui/*"]
    }
  },
  "include": ["src", "../../apps/v4/registry/coss-ui"]
}
